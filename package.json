{
  "name": "epost-mcp",
  "version": "0.12.0",
  "description": "MCP server for the Swiss ePost digital letterbox: list, download and archive letters over the documented public API, with browser automation as fallback.",
  "type": "module",
  "bin": {
    "epost-mcp": "index.js"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node index.js",
    "postinstall-hint": "npx playwright install chromium",
    "smoke": "node scripts/smoke.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "test": "node --test --test-concurrency=1 test/api.test.mjs test/browser.test.mjs test/hygiene.test.mjs",
    "prepublishOnly": "node --check index.js && node scripts/smoke.mjs && node scripts/hygiene.mjs",
    "coverage": "c8 --reporter=text-summary --include=index.js --check-coverage --lines 80 --functions 90 node --test --test-concurrency=1 test/api.test.mjs test/browser.test.mjs test/hygiene.test.mjs",
    "gate": "npm run lint && node scripts/smoke.mjs && node scripts/hygiene.mjs && npm run coverage",
    "lint": "eslint .",
    "mutate": "node scripts/mutate-changed.mjs",
    "mutate:all": "stryker run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "epost",
    "swiss-post",
    "playwright",
    "digital-letterbox"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.62.0"
  },
  "license": "MIT",
  "author": "sapn95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapn95/epost-mcp.git"
  },
  "homepage": "https://github.com/sapn95/epost-mcp#readme",
  "bugs": {
    "url": "https://github.com/sapn95/epost-mcp/issues"
  },
  "files": [
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "@hono/node-server": "^2.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "c8": "^12.0.0",
    "eslint": "^10.8.0"
  }
}
