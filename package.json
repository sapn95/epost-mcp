{
  "name": "epost-mcp",
  "version": "0.7.0",
  "description": "MCP server for the Swiss ePost digital letterbox: list and download scanned letters, manage Storage folders, with a cached session and an assisted one-fingerprint SwissID login.",
  "type": "module",
  "bin": {
    "epost-mcp": "index.js"
  },
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node index.js",
    "postinstall-hint": "npx playwright install chromium",
    "smoke": "node scripts/smoke.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "test": "node --check index.js && node scripts/smoke.mjs && node scripts/hygiene.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "epost",
    "swiss-post",
    "playwright",
    "digital-letterbox"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.61.0"
  },
  "license": "MIT",
  "author": "sapn95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapn95/epost-mcp.git"
  },
  "homepage": "https://github.com/sapn95/epost-mcp#readme",
  "bugs": {
    "url": "https://github.com/sapn95/epost-mcp/issues"
  }
}
