{
  "name": "epost-mcp",
  "version": "0.4.0",
  "description": "MCP server for the Swiss ePost digital letterbox (app.epost.ch) — list/download scanned letters and organise Storage (list folders & documents, create folders, move documents) via Playwright, with a cached SwissID session that survives restarts",
  "type": "module",
  "bin": { "epost-mcp": "index.js" },
  "main": "index.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node index.js",
    "postinstall-hint": "npx playwright install chromium"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "epost",
    "swiss-post",
    "playwright",
    "digital-letterbox"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "^1.61.0"
  },
  "license": "MIT",
  "author": "sapn95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapn95/epost-mcp.git"
  },
  "homepage": "https://github.com/sapn95/epost-mcp#readme",
  "bugs": {
    "url": "https://github.com/sapn95/epost-mcp/issues"
  }
}
